# Copy this to .env and fill in values: `cp .env.example .env`
# .env is listed in .gitignore -- never commit real secrets.

# --- Server -----------------------------------------------------------
# Port the Express server listens on.
PORT=3000

# development | production | test. Test files set this to 'test'
# themselves (see tests/helpers/setup.js) -- you don't need to for `npm test`.
NODE_ENV=development

# --- Auth / tokens ------------------------------------------------------
# Required. Any random string for local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs and verifies access JWTs. The app throws on startup/first request
# if this is unset -- there is no default.
JWT_SECRET=

# Used by passport for OAuth session handling. Any random string for local dev.
SESSION_SECRET=

# How long an access token is valid for. Accepts a number of seconds, or a
# string like '30s' / '15m' / '2h' / '7d'.
JWT_EXPIRES_IN=15m

# How long a refresh token is valid for. Same format as JWT_EXPIRES_IN.
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Multi-tenancy --------------------------------------------------------
# How a request's tenant is resolved: 'header' (x-tenant-id) or 'subdomain'.
# See src/middleware/tenantResolver.js.
TENANT_RESOLUTION=header

# --- Estimating: digital acceptance ---------------------------------------
# Base URL this app is served from, used only to build a full clickable
# link (estimate.shareUrl) in the response right after an estimate's share
# token is issued (create/revise/regenerate-link). Optional -- without it,
# responses still include the raw `shareToken`, you'd just build the link
# yourself as `${yourAppUrl}/public/estimates/${shareToken}`. No trailing
# slash needed (one is stripped if present).
PUBLIC_APP_URL=http://localhost:3000

# --- Platform admin / cross-tenant support access ------------------------
# See README "Platform admin: cross-tenant support access" for the full
# design. Neither of these is required for normal operation.

# Gates POST /platform-admin/bootstrap-grant, the one HTTP-reachable way to
# flip a user's platformAdmin flag against the current in-memory store (see
# README for the real-database alternative). Leave unset to disable the
# endpoint entirely (its normal state day-to-day); set it temporarily only
# long enough to grant your initial platform admin(s). Treat it like a
# root/master key -- pick something long and random, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_ADMIN_BOOTSTRAP_SECRET=

# How long a POST /platform-admin/impersonate access token is valid for.
# Deliberately short and non-refreshable -- expiry forces platformAdmin
# status to be re-checked on every new impersonation session. Same format
# as JWT_EXPIRES_IN.
IMPERSONATION_TOKEN_EXPIRES_IN=10m

# --- SMS / text messaging (no vendor lock-in) ------------------------------
# See README "SMS / text messaging" for the full design. Which provider is
# active -- switching is changing this one value, no code changes:
#   console (default, safe for local dev -- logs instead of sending)
#   telnyx | plivo | twilio | bird | aws_sns
SMS_PROVIDER=console

# The business's SMS number, used as the "from" on every outbound message.
# One number for the whole app instance (not per-tenant) -- see README's
# "one global number" limitation before running this as multi-tenant SaaS
# for unrelated businesses.
SMS_FROM_NUMBER=

# Reject a provider webhook whose signature doesn't verify, instead of
# processing it anyway with a warning logged. Off by default so a fresh
# setup isn't broken by a provider whose verification isn't (yet) fully
# implemented here -- turn this on once you've confirmed your chosen
# provider's signature check actually passes for real traffic.
SMS_WEBHOOK_STRICT_VERIFICATION=false

# Telnyx -- npm install telnyx
TELNYX_API_KEY=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_PUBLIC_KEY=

# Plivo -- npm install plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Twilio -- npm install twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Bird (formerly MessageBird) -- npm install messagebird
BIRD_ACCESS_KEY=
BIRD_SIGNING_KEY=

# AWS SNS -- npm install @aws-sdk/client-sns
# Credentials use the AWS SDK's normal resolution chain (env vars, shared
# credentials file, IAM role), not a custom var here.
AWS_REGION=

# --- OAuth: Google (covers Gmail + Google Workspace accounts) -----------
# From https://console.cloud.google.com/apis/credentials
# Set the authorized redirect URI to GOOGLE_CALLBACK_URL below.
# A provider is only registered if both its CLIENT_ID and CLIENT_SECRET are
# set, so you can leave these blank and run with just GitHub configured
# (or neither, if you're only testing non-OAuth routes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- OAuth: GitHub (optional) --------------------------------------------
# From https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
