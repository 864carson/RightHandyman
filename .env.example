# Copy this to .env and fill in values: `cp .env.example .env`
# .env is listed in .gitignore -- never commit real secrets.

# --- Server -----------------------------------------------------------
# Port the Express server listens on.
PORT=3000

# development | production | test. Test files set this to 'test'
# themselves (see tests/helpers/setup.js) -- you don't need to for `npm test`.
NODE_ENV=development

# --- Auth / tokens ------------------------------------------------------
# Required. Any random string for local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs and verifies access JWTs. The app throws on startup/first request
# if this is unset -- there is no default.
JWT_SECRET=

# Used by passport for OAuth session handling. Any random string for local dev.
SESSION_SECRET=

# How long an access token is valid for. Accepts a number of seconds, or a
# string like '30s' / '15m' / '2h' / '7d'.
JWT_EXPIRES_IN=15m

# How long a refresh token is valid for. Same format as JWT_EXPIRES_IN.
REFRESH_TOKEN_EXPIRES_IN=30d

# --- Multi-tenancy --------------------------------------------------------
# How a request's tenant is resolved: 'header' (x-tenant-id) or 'subdomain'.
# See src/middleware/tenantResolver.js.
TENANT_RESOLUTION=header

# --- OAuth: Google (covers Gmail + Google Workspace accounts) -----------
# From https://console.cloud.google.com/apis/credentials
# Set the authorized redirect URI to GOOGLE_CALLBACK_URL below.
# A provider is only registered if both its CLIENT_ID and CLIENT_SECRET are
# set, so you can leave these blank and run with just GitHub configured
# (or neither, if you're only testing non-OAuth routes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# --- OAuth: GitHub (optional) --------------------------------------------
# From https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
